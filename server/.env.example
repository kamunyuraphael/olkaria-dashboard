PORT=4000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/olkaria-dashboard
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CLIENT_ORIGIN=http://localhost:5173

# Base URL of the Python analysis-service (owned by the analysis team).
# The worker calls into it for the actual CO2-ANN / AERMOD computation.
ANALYSIS_SERVICE_URL=http://localhost:8000

# Where uploaded files are held while a job is queued/running.
UPLOAD_DIR=./src/uploads

# Only read by `npm run seed:admin` (src/scripts/seedAdmin.ts), not by the
# server itself - set these on the command line when you run it, not here,
# since there's no reason for the admin password to sit in a committed
# .env file. Bootstraps the first admin account; every other account comes
# from an admin approving an access request (see API_CONTRACT.md).
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=Admin
# ADMIN_INSTITUTION=Olkaria Dashboard

# --- Production / split hosting ---
# Comma-separated list of allowed frontend origins
# CLIENT_ORIGIN=https://your-app.vercel.app
# Shared secret with the analysis-service (set the same value there)
# ANALYSIS_SERVICE_TOKEN=
# Run workers inside the API process (free hosting, no separate worker)
# RUN_WORKERS_IN_PROCESS=true
